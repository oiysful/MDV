{
  "name": "mdv",
  "productName": "MDV",
  "version": "1.4.0",
  "description": "Claude-style Markdown Editor",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "install:local": "bash scripts/install-local.sh",
    "update:local": "bash scripts/update-local.sh",
    "install:release": "bash scripts/install-release.sh",
    "update:release": "bash scripts/update-release.sh",
    "test:electron": "node --test --test-concurrency=${MDV_ELECTRON_CONCURRENCY:-4} tests/electron/*.test.js",
    "test:e2e": "node --test --test-concurrency=${MDV_ELECTRON_CONCURRENCY:-4} --test-name-pattern=\"${E2E:-.}\" tests/electron/*.test.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:controller": "node --test tests/controller/*.test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@highlightjs/cdn-assets": "^11.12.0",
    "chokidar": "^5.0.0",
    "dompurify": "^3.4.17",
    "js-yaml": "^5.4.2",
    "katex": "^0.18.9",
    "marked": "^9.1.6",
    "mermaid": "^11.16.0"
  },
  "devDependencies": {
    "electron": "^44.9.3",
    "electron-builder": "^26.8.1",
    "jsdom": "^30.1.1",
    "playwright": "^1.63.0"
  },
  "build": {
    "appId": "com.ian.mdv",
    "productName": "MDV",
    "mac": {
      "target": "zip",
      "minimumSystemVersion": "13.0",
      "icon": "assets/icon.icns"
    },
    "electronLanguages": [
      "ko",
      "en"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "resetAdHocDarwinSignature": true
    },
    "fileAssociations": [
      {
        "ext": "md",
        "name": "Markdown",
        "role": "Editor"
      },
      {
        "ext": "markdown",
        "name": "Markdown",
        "role": "Editor"
      }
    ],
    "files": [
      "src/**/*",
      "assets/**/*"
    ]
  }
}
